<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:YMouseButtonControl.Converters"
        xmlns:processSelectorDialog="clr-namespace:YMouseButtonControl.Core.ViewModels.Dialogs.ProcessSelectorDialog;assembly=YMouseButtonControl.Core"
        xmlns:i18n="clr-namespace:YMouseButtonControl.Core.Localization;assembly=YMouseButtonControl.Core"
        x:DataType="processSelectorDialog:ProcessSelectorDialogViewModel"
        x:CompileBindings="True"
        mc:Ignorable="d"
        d:DesignWidth="400"
        d:DesignHeight="600"
        Width="500"
        Height="600"
        WindowStartupLocation="CenterOwner"
        x:Class="YMouseButtonControl.Views.Dialogs.ProcessSelectorDialog"
        CanResize="True"
        Title="{i18n:Tr Proc_Title}"
        RequestedThemeVariant="{Binding ThemeVariant}">

    <Design.DataContext>
        <processSelectorDialog:ProcessSelectorDialogViewModel />
    </Design.DataContext>
    
    <Window.Resources>
        <converters:BitmapStreamConverter x:Key="BmpStreamConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="10">
        <!-- Row 1 -->
        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Top">
            <Label Content="{i18n:Tr Proc_SelectRunning}" />
            <Button Grid.Column="1"
                    Content="{i18n:Tr Btn_Refresh}"
                    Command="{Binding RefreshButtonCommand}"
                    HorizontalAlignment="Right"/>
            <TextBox Grid.Column="2" Text="{Binding ProcessFilter}" Watermark="{i18n:Tr Proc_FilterWatermark}" />
        </Grid>

        <!-- Row 2 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Filtered}"
                  SelectedItem="{Binding SelectedProcessModel, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch" Margin="0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="12" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="12" Stretch="Uniform"  Source="{Binding Bitmap, Converter={StaticResource BmpStreamConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{i18n:Tr Proc_ColProcess}"  Binding="{Binding Process.MainModule.ModuleName}" />
                <DataGridTextColumn Header="{i18n:Tr Proc_ColProcessName}" Binding="{Binding Process.ProcessName}" />
                <DataGridTextColumn Header="{i18n:Tr Proc_ColWindowTitle}" Binding="{Binding Process.MainWindowTitle}" />
                <DataGridTextColumn Header="{i18n:Tr Proc_ColFileName}" Binding="{Binding Process.MainModule.FileName}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 3 -->
        <Label Grid.Row="2" VerticalAlignment="Top"
               Content="{i18n:Tr Proc_OrBrowse}" />

        <!-- Row 4 -->
        <Grid Grid.Row="3" ColumnDefinitions="150,*,Auto" VerticalAlignment="Top">
            <Label Content="{i18n:Tr Proc_Application}" />
            <TextBox Grid.Column="1" Text="{Binding SelectedProcessModuleName}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" Content="..." HorizontalAlignment="Right" />
        </Grid>

        <!-- Row 5 -->
        <Grid Grid.Row="4" ColumnDefinitions="150,*" VerticalAlignment="Top">
            <Label Content="{i18n:Tr Info_Description}" />
            <TextBox Grid.Column="1" HorizontalAlignment="Stretch" Text="{Binding SelectedProcessMainWindowTitle}" />
        </Grid>

        <!-- Row 6 -->
        <Grid Grid.Row="5" ColumnDefinitions="*,*,*" VerticalAlignment="Top">
            <Button Content="{i18n:Tr Proc_SpecificWindow}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="1" x:Name="OkButton" Content="{i18n:Tr Btn_Ok}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding OkCommand}" />
            <Button Grid.Column="2" x:Name="CancelButton" Content="{i18n:Tr Btn_Cancel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="CancelButton_OnClick" />
        </Grid>
    </Grid>

</Window>